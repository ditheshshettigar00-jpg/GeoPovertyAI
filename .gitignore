# ============================================
# GeoPovertyAI — .gitignore
# ============================================

# --- Virtual Environment (DO NOT upload) ---
venv/
.venv/
env/

# --- Model & Data Backups ---
models_before_*
models_*backup*
data/backup_old_extraction/

# --- SQLite Databases ---
database/*.db
database/*.db-wal
database/*.db-shm
*.db
*.db-wal
*.db-shm

# --- Python bytecode & cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Pytest ---
.pytest_cache/

# --- Application cache & temp ---
cache/
data/processed/temp/

# --- IDE / Editor files ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS files ---
Thumbs.db
.DS_Store
desktop.ini

# --- Jupyter Notebook checkpoints ---
.ipynb_checkpoints/

# --- Distribution / packaging ---
*.egg-info/
dist/
build/

# --- Environment variables ---
.env
.env.local

# --- Exploratory Visual Ablation Models ---
models/exploratory_visual_ablation/*.pkl
database/*.db

+# ------------------------------------------------------------- registration
+def _register(c, **extra):
+    email = f"reg_{uuid.uuid4().hex[:12]}@example.com"
+    body = {"name": "Reg User", "email": email, "password": "password123"}
+    body.update(extra)
+    return email, c.post("/api/auth/register", json=body)
